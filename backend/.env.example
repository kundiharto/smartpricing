# Salin ke .env dan sesuaikan. Nilai di bawah hanya untuk PostgreSQL lokal (development).
SPE_ENVIRONMENT=development
SPE_DATABASE_URL=postgresql+psycopg://spe_app:spe_app_dev@localhost:5432/spe_dev
SPE_MIGRATION_DATABASE_URL=postgresql+psycopg://spe_owner:spe_owner_dev@localhost:5432/spe_dev
# Wajib diganti di production (minimal 32 karakter acak).
SPE_JWT_SECRET=dev-only-insecure-secret-change-me-0000000000
SPE_ACCESS_TOKEN_TTL_MINUTES=480
